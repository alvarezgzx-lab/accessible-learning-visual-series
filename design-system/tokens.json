{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Accessible Learning Visual Series",
  "version": "1.0.0",
  "palette_source": {
    "authority": "latest-approved-infographic",
    "asset": "El stack construye. L&D decide qué vale la pena construir. (1).pdf",
    "method": "visual sampling from the approved piece; exact Canva Brand Kit values must be reconciled before locking the template",
    "status": "provisional-until-canva-reconciled"
  },
  "color": {
    "ink": { "value": "#17324D", "role": "primary text and dark panels" },
    "paper": { "value": "#F6F1E8", "role": "primary background" },
    "rust": { "value": "#B65A3A", "role": "large headings, rules and decorative emphasis" },
    "teal": { "value": "#3E7568", "role": "secondary accents and framework tags" },
    "blue": { "value": "#3157C8", "role": "focus, links and relationships" },
    "white": { "value": "#FFFFFF", "role": "text on ink panels" },
    "muted": { "value": "#475467", "role": "secondary text on light backgrounds" },
    "success": { "value": "#2E6B4F", "role": "status with an accompanying label or icon" },
    "warning": { "value": "#9A5B00", "role": "warnings with an accompanying label or icon" }
  },
  "typography": {
    "display": { "family": "League Spartan", "fallback": "Arial Black, sans-serif", "weight": 700 },
    "heading": { "family": "Montserrat", "fallback": "Arial, sans-serif", "weight": 700 },
    "body": { "family": "Atkinson Hyperlegible", "fallback": "Arial, sans-serif", "weight": 400 },
    "min_static_body_pt": 18,
    "min_web_body_px": 16,
    "min_web_touch_target_px": 44,
    "max_body_line_length_ch": 72,
    "body_line_height": 1.5
  },
  "spacing": {
    "base": 8,
    "canvas_safe_margin_percent": 5,
    "panel_gap_units": 3,
    "section_gap_units": 5
  },
  "grid": {
    "columns": 12,
    "mobile_columns": 4,
    "reading_direction": "left-to-right-top-to-bottom"
  },
  "shape": {
    "corner_radius_px": 16,
    "rule_width_px": 2,
    "focus_width_px": 3
  },
  "iconography": {
    "style": "simple corporate outline with editorial geometric accents",
    "rules": [
      "pair every meaningful icon with a visible text label",
      "use a consistent stroke family",
      "do not encode state by color alone",
      "avoid decorative illustrations that compete with the learning message"
    ]
  },
  "motion": {
    "duration_ms": 180,
    "reduced_motion": "remove non-essential transitions"
  }
}
